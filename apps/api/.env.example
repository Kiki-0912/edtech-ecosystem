NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# "*", or a comma-separated list of allowed origins. A separately deployed admin
# console needs its own origin listed next to the web app's, e.g.
# CORS_ORIGIN=https://edtech-web.netlify.app,https://edtech-admin.netlify.app
CORS_ORIGIN=*
# Production: replace with a long random value, e.g. `openssl rand -hex 32`.
AUTH_SECRET=replace-with-a-long-random-string

# Postgres connection string. Leave unset to use the seeded in-memory store
# (data resets on every restart). Local: `npm run db:up` starts Postgres via
# docker-compose. Hosted (Neon/Supabase/etc.) usually needs `?sslmode=require`.
# DATABASE_URL=postgresql://edtech:edtech@localhost:5432/edtech
# Max pooled connections per process (keep small on serverless). Default 5.
# DATABASE_POOL_MAX=5
# On Netlify, Netlify DB sets NETLIFY_DATABASE_URL, which is used when
# DATABASE_URL is unset.
# Seed demo accounts (shared password "password123") into an empty database.
# Set to false for a real deployment; the college/departments are always seeded.
SEED_DEMO_DATA=true
# Optional: give every seeded account this password instead of "password123",
# and the seeded admin this login email. Set these on any public deployment.
# SEED_DEMO_PASSWORD=
# SEED_ADMIN_EMAIL=
# Local demos only: return SMS sign-in codes in /auth/send-sms responses and logs.
# Never enable on a deployment (anyone could sign in as any phone).
# `npm run dev:api` enables it for you.
# SMS_DEV_ECHO=true
